# ==============================================================================
# KPATA — Variables d'environnement
# ==============================================================================

# URL publique du site (injectée automatiquement sur AI Studio ou définie sur Vercel)
APP_URL="http://localhost:3000"

# Clé secrète de signature des sessions (laisser vide en dev pour génération automatique en mémoire, OBLIGATOIRE en production)
SESSION_SECRET=""

# Base de données PostgreSQL Neon (utilisée avec Prisma pour le déploiement Vercel / Production)
DATABASE_URL=""
DIRECT_URL=""

# Stockage externe compatible S3 / Cloudflare R2 pour les justificatifs (optionnel en local, recommandé en production)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# FedaPay — Paiement des abonnements (Sandbox ou Live)
# Ne jamais préfixer FEDAPAY_SECRET_KEY avec VITE_ ou NEXT_PUBLIC_
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# Google Analytics 4 (identifiant de mesure public, ex: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""

# Google Search Console & Bing Webmaster Tools (codes de vérification HTML meta)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Mot de passe administrateur initial (optionnel : si vide, l'espace admin propose la création initiale sécurisée ou utilise le compte seedé)
ADMIN_BOOTSTRAP_PASSCODE=""

# Gemini API (optionnel, uniquement si fonctionnalités intelligentes activées)
GEMINI_API_KEY=""
